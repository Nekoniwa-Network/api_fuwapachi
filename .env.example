# MariaDB接続設定
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# CORS設定
ALLOWED_ORIGINS=

# レート制限: CF-Connecting-IP を信じてよい接続元（cloudflared）の範囲
# カンマ区切りの CIDR。空なら誰も信頼せず、接続元の IP（RemoteAddr のホスト部分）で数える
TRUSTED_PROXY_CIDRS=

# サーバー設定
SERVER_PORT=8080
ENV=development

# WebSocket の同時接続数の上限（未設定なら 1000）
WS_MAX_CONNECTIONS=