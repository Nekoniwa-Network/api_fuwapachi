# MariaDB接続設定
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# CORS設定
ALLOWED_ORIGINS=

# レート制限: CF-Connecting-IP を信じてよい接続元（cloudflared）の範囲
# カンマ区切りの CIDR（例: 100.101.188.8/32）。空なら誰も信頼せず、変更前と同じく RemoteAddr（IP:ポート）で数える
# トンネルの裏で動かす本番では必ず設定する（ENV=production で未設定なら起動時に警告を出す）
TRUSTED_PROXY_CIDRS=

# サーバー設定
SERVER_PORT=8080
ENV=development

# WebSocket の同時接続数の上限（未設定なら 1000）
WS_MAX_CONNECTIONS=

# WebSocket の接続元ごとの同時接続数の上限（未設定なら 10。TRUSTED_PROXY_CIDRS が空のときは使わない）
WS_MAX_CONNECTIONS_PER_IP=